{
  "name": "action-mattermost-notify",
  "description": "GitHub Action for delivering CI/CD alerts and pipeline status updates to Mattermost channels via incoming webhooks",
  "version": "2.1.0",
  "author": "step-security",
  "private": true,
  "homepage": "https://github.com/step-security/action-mattermost-notify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/action-mattermost-notify.git"
  },
  "bugs": {
    "url": "https://github.com/step-security/action-mattermost-notify/issues"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "TypeScript"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npx ncc build src/index.ts -o dist --source-map",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "testPathIgnorePatterns": ["/node_modules/", "/dist/"]
  },
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@actions/http-client": "^3.0.0",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  }
}
